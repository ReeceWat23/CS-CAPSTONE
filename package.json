  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest coverage.test.js ./referrals/referrals.test.js ./frontend/messages/messages.test.js ./search/basic_search.test.js ./frontend/user_logic/users.test.js yocto-queue.test.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage coverage.test.js ./referrals/referrals.test.js ./frontend/messages/messages.test.js ./search/basic_search.test.js ./frontend/user_logic/users.test.js yocto-queue.test.js ./analytics/analytics.test.js",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest API_bubble/api.connect.test.js",
    "demo:search": "node Search/demo.js",
    "test:messages": "NODE_OPTIONS=--experimental-vm-modules jest frontend/messages/messages.test.js",
    "test:search": "NODE_OPTIONS=--experimental-vm-modules jest --coverage Search/basic_search.test.js",
    "test:branch": "NODE_OPTIONS=--experimental-vm-modules jest --coverage Branches/branch.test.js",
    "test:a": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage coverage.test.js ./referrals/referrals.test.js ./frontend/messages/messages.test.js ./search/basic_search.test.js ./frontend/user_logic/users.test.js yocto-queue.test.js ./analytics/analytics.test.js ./Branches/branch.test.js"
  },
  "dependencies": {
